# WiKirecTangled environment variables.
# Copy this file to `.env` and replace placeholder values.
#
# `.env` is .gitignore'd. Never commit real secrets.

# ---- Required for production ----

# HMAC-style secret used for:
#   - Chat Relay app-register handshake (must match Chat Relay's GAME_API_SECRET)
#   - Word Tycoon ELO POSTs (x-api-key header)
# Without this set, both integrations gracefully no-op (game still runs).
GAME_API_SECRET=

# ---- Network / integrations ----

# Chat Relay endpoint — provides the chat-message bridge + word-bank API.
# Default falls back to local dictionary.json if unreachable.
CHAT_RELAY_URL=http://localhost:3000

# Filesystem path Chat Relay's wikipedia-coverage.json lives at. The article
# picker reads this 11MB file. Either symlink it into ./data/ or set this var.
WIKI_COVERAGE_PATH=/opt/chat-relay/data/wikipedia-coverage.json

# Word Tycoon ELO endpoint. Disabled when unset (or when GAME_API_SECRET is unset).
WORD_EMPIRES_URL=http://localhost:3020

# ---- Server runtime ----

# HTTP/WebSocket port. 3031 in production (3010-3030 are all taken on the
# WordTycoon-family Hetzner box). Locally use anything free — the launcher
# defaults to 3017 if PORT is unset, which is fine on a clean dev machine.
PORT=3031

# SQLite file location. Server creates the file on first run.
DB_PATH=/opt/wikirectangled/data/wikirectangled.db

# Validated recovery point refreshed only after the live DB passes quick_check.
DB_BACKUP_PATH=/opt/wikirectangled/data/wikirectangled.db.bak

# Timezone the daily puzzle rolls in. Match Word Tycoon family (Edmonton).
DAILY_TIMEZONE=America/Edmonton

# Set to `1` to skip the Chat Relay bridge entirely on boot (useful for
# isolated dev when Chat Relay isn't running).
DISABLE_CHAT_RELAY=0
